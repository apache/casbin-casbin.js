{
  "name": "casbin.js",
  "version": "1.2.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "NOTICE",
    "DISCLAIMER"
  ],
  "sideEffects": false,
  "repository": "https://github.com/apache/casbin-casbin.js.git",
  "author": "Casbin",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "resolutions": {
    "@types/minimatch": "5.1.2"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "rimraf lib && tsc",
    "test": "jest --config jestconfig.json --unhandled-rejections=strict",
    "test:coverage": "jest --config jestconfig.json --coverage",
    "prod": "webpack --config webpack.prod.js",
    "dev": "webpack serve --config webpack.dev.js",
    "clean": "rimraf lib",
    "prepack": "run-s build",
    "postpack": "run-s clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "clean-webpack-plugin": "^4.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "casbin-core": "^0.0.0-beta.2",
    "js-cookie": "^3.0.8"
  }
}
